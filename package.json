{
  "name": "@kubohiroya/turbowarp-async-input",
  "version": "0.2.0",
  "description": "A target-scoped asynchronous keyboard, pointer, and accumulated pose input extension for TurboWarp.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-async-input.git"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-async-input/",
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-async-input/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "input",
    "keyboard",
    "pointer",
    "pose"
  ],
  "type": "module",
  "exports": {
    "./async-input.js": "./dist/async-input.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "unpkg": "./dist/async-input.js",
  "jsdelivr": "./dist/async-input.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.mjs",
    "docs:check": "node scripts/generate-readme.mjs --check",
    "site:check": "node scripts/check-site.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "npm publish --dry-run --access public",
    "check": "npm run typecheck && npm run test && npm run build && npm run docs:check && npm run site:check && npm run check:dist && npm run pack:check",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
