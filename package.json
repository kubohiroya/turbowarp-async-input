{
  "name": "@kubohiroya/turbowarp-async-input",
  "version": "0.6.0",
  "description": "A target-scoped asynchronous keyboard, pointer, and accumulated pose input extension for TurboWarp.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-async-input.git"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-async-input/",
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-async-input/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "input",
    "keyboard",
    "pointer",
    "pose"
  ],
  "type": "module",
  "exports": {
    "./composition": {
      "types": "./dist/types/composition.d.ts",
      "import": "./dist/composition.js"
    },
    "./async-input.js": "./dist/async-input.js"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "unpkg": "./dist/async-input.js",
  "jsdelivr": "./dist/async-input.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-jsqr": ">=0.1.0 <1",
    "@kubohiroya/turbowarp-webusb-pasori": ">=0.1.0 <1"
  },
  "peerDependenciesMeta": {
    "@kubohiroya/turbowarp-jsqr": {
      "optional": true
    },
    "@kubohiroya/turbowarp-webusb-pasori": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:extension && pnpm run build:composition && pnpm run build:types",
    "build:extension": "vite build",
    "build:composition": "vite build --config vite.composition.config.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "types:composition:check": "tsc --project tsconfig.composition-consumer.json",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.mjs",
    "docs:check": "node scripts/generate-readme.mjs --check",
    "site:check": "node scripts/check-site.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "npm publish --dry-run --access public",
    "repo:check": "node scripts/check-repo.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run types:composition:check && pnpm run docs:check && pnpm run site:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "prepack": "pnpm run check"
  },
  "devDependencies": {
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
